{
  "name": "@architecture-tokens/drawio-prototype",
  "version": "0.1.0",
  "description": "Validated Architecture Tokens to editable draw.io CLI prototype",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "archtokens": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@architecture-tokens/spec": "git+https://github.com/architecture-tokens/spec.git#207a608684914dc97fac17c5caff044491b2d848",
    "@xmldom/xmldom": "^0.9.8",
